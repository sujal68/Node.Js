        <script>
            document.addEventListener('DOMContentLoaded', function () {
                // Initialize Feather Icons
                if (typeof feather !== 'undefined') {
                    feather.replace();
                }

                // Search Functionality
                const searchInput = document.getElementById('search-input');
                const searchBtn = document.getElementById('search-btn');
                const clearSearchBtn = document.getElementById('clear-search');
                const adminTableBody = document.getElementById('admin-table-body');

                function performSearch() {
                    const searchTerm = searchInput.value.toLowerCase().trim();

                    if (searchTerm) {
                        clearSearchBtn.style.display = 'block';

                        const rows = adminTableBody.querySelectorAll('tr');
                        let hasResults = false;

                        rows.forEach(row => {
                            const rowText = row.textContent.toLowerCase();
                            if (rowText.includes(searchTerm)) {
                                row.style.display = '';
                                hasResults = true;
                            } else {
                                row.style.display = 'none';
                            }
                        });

                        if (!hasResults) {
                            showNotification('No admins found matching your search', 'warning');
                        }
                    } else {
                        clearSearch();
                    }
                }

                function clearSearch() {
                    searchInput.value = '';
                    clearSearchBtn.style.display = 'none';

                    const rows = adminTableBody.querySelectorAll('tr');
                    rows.forEach(row => {
                        row.style.display = '';
                    });
                }

                searchInput.addEventListener('input', performSearch);
                searchBtn.addEventListener('click', performSearch);
                clearSearchBtn.addEventListener('click', clearSearch);

                // Enter key for search
                searchInput.addEventListener('keypress', function (e) {
                    if (e.key === 'Enter') {
                        performSearch();
                    }
                });

                // Modal setup
                const viewModal = new bootstrap.Modal(document.getElementById('viewAdminModal'));

                // Edit from modal button
                document.getElementById('editFromModal').addEventListener('click', function () {
                    const adminId = this.getAttribute('data-admin-id');
                    if (adminId) {
                        viewModal.hide();
                        editAdmin(adminId);
                    }
                });

                // Modal event listeners to fix scroll issues
                viewModal._element.addEventListener('show.bs.modal', function () {
                    // Add custom class to body
                    document.body.classList.add('modal-open-custom');
                });

                viewModal._element.addEventListener('hidden.bs.modal', function () {
                    // Remove custom class from body
                    document.body.classList.remove('modal-open-custom');
                });
            });

            // View Admin Function - FIXED VERSION
            function viewAdmin(id) {
                const adminRow = document.querySelector(`tr[data-id="${id}"]`);

                if (!adminRow) {
                    showNotification('Admin not found!', 'error');
                    return;
                }

                // Get data from data attributes
                const adminData = {
                    id: adminRow.getAttribute('data-id'),
                    name: adminRow.getAttribute('data-name'),
                    email: adminRow.getAttribute('data-email'),
                    phone: adminRow.getAttribute('data-phone'),
                    city: adminRow.getAttribute('data-city'),
                    gender: adminRow.getAttribute('data-gender'),
                    status: adminRow.getAttribute('data-status'),
                    hobbies: adminRow.getAttribute('data-hobbies'),
                    about: adminRow.getAttribute('data-about'),
                    avatar: adminRow.getAttribute('data-avatar')
                };

                // Update modal content
                document.getElementById('adminModalName').textContent = adminData.name;
                document.getElementById('adminModalEmail').textContent = adminData.email;
                document.getElementById('adminModalPhone').textContent = adminData.phone;
                document.getElementById('adminModalCity').textContent = adminData.city;
                document.getElementById('adminModalGender').textContent = adminData.gender;
                document.getElementById('adminModalHobbies').textContent = adminData.hobbies;
                document.getElementById('adminModalAbout').textContent = adminData.about;
                document.getElementById('adminModalAvatar').src = adminData.avatar;
                document.getElementById('adminModalId').textContent = `#AD${adminData.id.toString().padStart(3, '0')}`;

                // Update status badge
                const statusBadge = document.getElementById('adminModalStatus');
                statusBadge.textContent = adminData.status;
                statusBadge.className = `badge bg-${adminData.status === 'Active' ? 'success' : 'warning'}`;

                // Set edit button data
                document.getElementById('editFromModal').setAttribute('data-admin-id', adminData.id);

                // Show modal
                const modal = new bootstrap.Modal(document.getElementById('viewAdminModal'));
                modal.show();

                // Update feather icons in modal
                if (typeof feather !== 'undefined') {
                    feather.replace();
                }
            }

            // Edit Admin Function
            function editAdmin(id) {
                const btn = event?.target?.closest('button');

                if (btn) {
                    // Show loading state
                    const originalHTML = btn.innerHTML;
                    btn.innerHTML = '<span class="loading"></span>';
                    btn.disabled = true;

                    // Simulate API call/redirect
                    setTimeout(function () {
                        btn.innerHTML = originalHTML;
                        btn.disabled = false;

                        // Show notification
                        showNotification(`Redirecting to edit admin #${id}...`, 'info');

                        // In real app, redirect to edit page
                        // window.location.href = '/editAdmin/' + id;

                        // For demo, show alert
                        setTimeout(() => {
                            alert(`In real application, this would redirect to edit page for admin ID: ${id}\n\nRedirect URL: /editAdmin/${id}`);
                        }, 500);
                    }, 800);
                }
            }

            // Delete Admin Function
            function deleteAdmin(id) {
                if (confirm(`Are you sure you want to delete admin #AD${id.toString().padStart(3, '0')}? This action cannot be undone.`)) {
                    const btn = event?.target?.closest('button');

                    if (btn) {
                        // Show loading state
                        const originalHTML = btn.innerHTML;
                        btn.innerHTML = '<span class="loading"></span>';
                        btn.disabled = true;

                        // Simulate API call
                        setTimeout(function () {
                            // Remove admin row with animation
                            const adminRow = document.querySelector(`tr[data-id="${id}"]`);

                            if (adminRow) {
                                adminRow.style.animation = 'fadeOut 0.5s ease forwards';

                                setTimeout(function () {
                                    adminRow.remove();
                                    showNotification(`Admin #AD${id.toString().padStart(3, '0')} deleted successfully!`, 'success');

                                    // Check if no admins left
                                    const remainingRows = document.querySelectorAll('#admin-table-body tr');
                                    if (remainingRows.length === 0) {
                                        showEmptyState();
                                    }
                                }, 500);
                            }

                            btn.innerHTML = originalHTML;
                            btn.disabled = false;
                        }, 1000);
                    }
                }
            }

            // Show Notification
            function showNotification(message, type = 'info') {
                // Remove existing notifications
                const existingNotifications = document.querySelectorAll('.custom-notification');
                existingNotifications.forEach(notification => notification.remove());

                const notification = document.createElement('div');
                notification.className = `alert alert-${type} custom-notification`;

                const icons = {
                    'success': 'check-circle',
                    'error': 'alert-circle',
                    'warning': 'alert-triangle',
                    'info': 'info'
                };

                notification.innerHTML = `
            <div class="d-flex align-items-center">
                <i data-feather="${icons[type] || 'info'}" class="me-2"></i>
                <span>${message}</span>
                <button type="button" class="btn-close ms-auto" onclick="this.parentElement.parentElement.remove()"></button>
            </div>
        `;

                document.body.appendChild(notification);

                // Initialize feather icon
                if (typeof feather !== 'undefined') {
                    feather.replace();
                }

                // Auto remove after 5 seconds
                setTimeout(() => {
                    if (notification.parentNode) {
                        notification.style.animation = 'slideOutRight 0.3s ease forwards';
                        setTimeout(() => {
                            if (notification.parentNode) {
                                notification.remove();
                            }
                        }, 300);
                    }
                }, 5000);
            }

            // Show empty state
            function showEmptyState() {
                const tableBody = document.getElementById('admin-table-body');
                tableBody.innerHTML = `
            <tr>
                <td colspan="9" class="text-center py-5">
                    <div class="empty-state">
                        <i data-feather="users" class="text-muted mb-3" style="width: 60px; height: 60px;"></i>
                        <h5 class="text-muted mb-2">No Admins Found</h5>
                        <p class="text-muted mb-4">There are no administrators in the system.</p>
                        <a href="/addAdmin" class="btn btn-primary">
                            <i data-feather="plus"></i> Add Your First Admin
                        </a>
                    </div>
                </td>
            </tr>
        `;

                if (typeof feather !== 'undefined') {
                    feather.replace();
                }
            }

            // Add custom CSS to fix modal scroll issues
            if (!document.querySelector('#modal-fix-css')) {
                const style = document.createElement('style');
                style.id = 'modal-fix-css';
                style.textContent = `
            .modal-open-custom {
                overflow: hidden !important;
                padding-right: 0 !important;
            }
            
            .modal-open-custom .modal {
                overflow-x: hidden;
                overflow-y: auto;
            }
            
            .modal-backdrop {
                background-color: rgba(0, 0, 0, 0.5);
            }
            
            .modal.show {
                display: block;
                overflow: hidden;
            }
            
            /* Fix for Bootstrap modal backdrop */
            body.modal-open {
                overflow: hidden;
                padding-right: 0 !important;
            }
        `;
                document.head.appendChild(style);
            }
        </script>

