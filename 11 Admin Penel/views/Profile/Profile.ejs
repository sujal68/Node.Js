            transform: scale(0.9);
            pointer-events: none;
            transition: 0.25s ease;
            z-index: 999;
        }

        .action-dropdown.active {
            opacity: 1;
            transform: scale(1);
            pointer-events: auto;
        }

        .action-dropdown button {
            width: 100%;
            background: none;
            border: none;
            color: #fff;
            padding: 8px 10px;
            text-align: left;
            border-radius: 6px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .action-dropdown button:hover {
            background: rgba(255, 255, 255, 0.08);
        }
    </style>

