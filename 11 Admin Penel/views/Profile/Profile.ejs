    <style>
        .action-menu {
            position: relative;
            display: inline-block;
        }

        .action-btn {
            font-size: 22px;
            cursor: pointer;
            color: #333;
        }

        .action-dropdown {
            position: absolute;
            right: 0;
            top: 28px;
            background: #111;
            border-radius: 10px;
            min-width: 120px;
            padding: 6px;
            box-shadow: 0 12px 25px rgba(0, 0, 0, 0.4);
