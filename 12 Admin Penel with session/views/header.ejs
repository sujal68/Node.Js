<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="Responsive Admin &amp; Dashboard Template based on Bootstrap 5">
    <meta name="author" content="AdminKit">
    <meta name="keywords"
        content="adminkit, bootstrap, bootstrap 5, admin, dashboard, template, responsive, css, sass, html, theme, front-end, ui kit, web">

    <link rel="preconnect" href="https://fonts.gstatic.com">
    <link rel="shortcut icon" href="/img/icons/icon-48x48.png" />

    <link rel="canonical" href="https://demo-basic.adminkit.io/" />

    <title>AdminKit Demo - Bootstrap 5 Admin Template</title>

    <link href="/css/app.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.8.0/fonts/remixicon.css" rel="stylesheet" />
</head>

<body>
    <div class="wrapper">
        <nav id="sidebar" class="sidebar js-sidebar">
            <div class="sidebar-content js-simplebar">
                <a class="sidebar-brand" href="/dashboard">
                    <span class="align-middle">My Admin's</span>
                </a>

                <ul class="sidebar-nav">
                    <li class="sidebar-header">
                        Pages
                    </li>

                    <li class="sidebar-item <%= currentPath === '/dashboard' ? 'active' : '' %>">
                        <a class="sidebar-link" href="/dashboard">
                            <i class="align-middle bx bx-home"></i> <span
                                class="align-middle">Dashboard</span>
                        </a>
                    </li>

                    <li class="sidebar-item <%= currentPath === '/profile' ? 'active' : '' %>">
                        <a class="sidebar-link" href="/profile">
                            <i class="align-middle ri-user-3-line"></i> <span class="align-middle">Profile</span>
                        </a>
                    </li>

                    <li class="sidebar-item <%= currentPath === '/viewAdmin' ? 'active' : '' %>">
                        <a class="sidebar-link" href="/viewAdmin">
                            <i class="align-middle bx bx-group"></i> <span class="align-middle">Manage
                                Admins</span>
                        </a>
                    </li>

                    <li class="sidebar-header">
                        Tools & Components
                    </li>


                    <li class="sidebar-item <%= currentPath === '/addAdmin' ? 'active' : '' %>">
                        <a class="sidebar-link" href="/addAdmin">
                            <i class="align-middle bx bx-user-plus"></i> <span class="align-middle">Add
                                Admin</span>
                        </a>
                    </li>
                    <li class="sidebar-header">
                        Categories
                    </li>


                    <li class="sidebar-item <%= currentPath === '/category/addCategoryPage' ? 'active' : '' %>">
                        <a class="sidebar-link" href="/category/addCategoryPage">
                            <i class="align-middle bx bx-category"></i> <span class="align-middle">Add
                                Categories</span>
                        </a>
                    </li>
                    <li class="sidebar-item <%= currentPath === '/category/viewCategoryPage' ? 'active' : '' %>">
                        <a class="sidebar-link" href="/category/viewCategoryPage">
                            <i class="align-middle ri-file-list-3-line"></i> <span class="align-middle">All
                                Categories</span>
                        </a>
                    </li>
                    <li class="sidebar-header">
                        Sub Categories
                    </li>


                    <li class="sidebar-item <%= currentPath === '/subCategory/addSubCategoryPage' ? 'active' : '' %>">
                        <a class="sidebar-link" href="/subCategory/addSubCategoryPage">
                            <i class="align-middle bx bx-list-ul"></i> <span class="align-middle">Add
                                Sub Categories</span>
                        </a>
                    </li>
                    <li class="sidebar-item <%= currentPath === '/subCategory/viewSubCategoryPage' ? 'active' : '' %>">
                        <a class="sidebar-link" href="/subCategory/viewSubCategoryPage">
                            <i class="align-middle bx bx-folder"></i> <span class="align-middle">All
                                Sub Categories</span>
                        </a>
                    </li>
                </ul>
            </div>
        </nav>