        <main class="content">
            <div class="container-fluid p-0">
                <div
                    class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                    <h1 class="h2">Profile</h1>
                </div>

                <div class="row">
                    <div class="col-md-4 col-xl-3">
                        <div class="card mb-3">
                            <div class="card-header">
                                <h5 class="card-title mb-0">Profile Details</h5>
                            </div>
                            <div class="card-body text-center">
                                <img src="<%= locals.admin.profile %>" alt="<%= admin.fname %> <%= admin.lname %>"
                                    class="img-fluid rounded-circle mb-2" width="128" height="128" />
                                <h5 class="card-title mb-0">
                                    <%= locals.admin.fname %>
                                        <%= locals.admin.lname %>
                                </h5>
                                <div class="text-muted mb-2">Administrator</div>
                                <div>
                                    <a class="btn btn-primary btn-sm"
                                        href="/editAdmin/<%= admin._id %>?returnTo=/profile">
                                        <i data-feather="edit-3"></i> Edit Profile
                                    </a>
                                </div>
                            </div>
                            <hr class="my-0" />
                            <div class="card-body">
                                <h5 class="h6 card-title">About</h5>
                                <ul class="list-unstyled mb-0">
                                    <li class="mb-1">
                                        <i data-feather="home" class="feather-sm me-1"></i> Lives in <strong>
                                            <%= admin.city || 'Not specified' %>
                                        </strong>
                                    </li>
                                    <li class="mb-1">
                                        <i data-feather="briefcase" class="feather-sm me-1"></i> Works as
                                        <strong>Administrator</strong>
                                    </li>
                                    <li class="mb-1">
                                        <i data-feather="map-pin" class="feather-sm me-1"></i> From <strong>
                                            <%= admin.city || 'Unknown' %>
                                        </strong>
                                    </li>
                                </ul>
                            </div>
                            <hr class="my-0" />
                            <div class="card-body">
                                <h5 class="h6 card-title">Elsewhere</h5>
                                <ul class="list-unstyled mb-0">
                                    <li class="mb-1"><a href="#">staciehall.co</a></li>
                                    <li class="mb-1"><a href="#">Twitter</a></li>
                                    <li class="mb-1"><a href="#">Facebook</a></li>
                                    <li class="mb-1"><a href="#">Instagram</a></li>
                                    <li class="mb-1"><a href="#">LinkedIn</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-8 col-xl-9">
                        <div class="card">
                            <div class="card-header">
                                <div class="card-actions float-end">
                                    <div class="dropdown position-relative">
                                        <a href="#" data-bs-toggle="dropdown" data-bs-display="static">
                                            <i class="align-middle" data-feather="more-horizontal"></i>
                                        </a>
                                        <div class="dropdown-menu dropdown-menu-end">
                                            <a class="dropdown-item"
                                                href="/editAdmin/<%= admin._id %>?returnTo=/profile">Edit Profile</a>
                                            <a class="dropdown-item" href="/change-password">Change Password</a>
                                            <a class="dropdown-item" href="/logout">Logout</a>
                                        </div>
                                    </div>
                                </div>
                                <h5 class="card-title mb-0">Personal Information</h5>
                            </div>
                            <div class="card-body h-100">
                                <div class="row">
                                    <div class="col-md-8">
                                        <div class="mb-3">
                                            <label class="form-label fw-bold text-primary">Full Name</label>
                                            <p class="form-control-plaintext fw-semibold text-dark">
                                                <%= admin.fname %>
                                                    <%= admin.lname %>
                                            </p>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label fw-bold text-primary">Email</label>
                                            <p class="form-control-plaintext fw-semibold text-dark">
                                                <%= admin.email %>
                                            </p>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label fw-bold text-primary">City</label>
                                            <p class="form-control-plaintext fw-semibold text-dark">
                                                <%= admin.city || 'Not specified' %>
                                            </p>
                                        </div>
                                        <% if (admin.hobby) { %>
                                            <div class="mb-3">
                                                <label class="form-label fw-bold text-primary">Hobby</label>
                                                <p class="form-control-plaintext fw-semibold text-dark">
                                                    <%= admin.hobby %>
                                                </p>
                                            </div>
                                            <% } %>
                                                <% if (admin.about) { %>
                                                    <div class="mb-3">
                                                        <label class="form-label fw-bold text-primary">About</label>
                                                        <p class="form-control-plaintext fw-semibold text-dark">
                                                            <%= admin.about %>
                                                        </p>
                                                    </div>
                                                    <% } %>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="text-center">
                                            <img alt="<%= admin.fname %> <%= admin.lname %>" src="<%= admin.profile %>"
                                                class="rounded-circle img-responsive mt-2" width="128" height="128" />
                                            <div class="mt-2">
                                                <span class="badge bg-primary">Administrator</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <script>
                document.addEventListener("DOMContentLoaded", function () {
                    feather.replace();
                });
            </script>
        </main>

        <%- include('../footer') %>