<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Book Page</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css">
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        a {
            color: white;
            text-decoration: none;
        }
    </style>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

</head>


<body>
    <h1 style="text-align: center;" class="m-5">All Book Collection</h1>

    <div class="container" style="width: 80%;">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th scope="col">Book No</th>
                    <th scope="col">Book Name</th>
                    <th scope="col">Book Author</th>
                    <th scope="col">Book Price</th>
                    <th scope="col">Book Language</th>
                    <th scope="col">Book</th>
                    <th scope="col">Action</th>
                </tr>
            </thead>
            <tbody>
                <% allbook.map((book , index)=> { %>

                    <tr>
                        <th scope="row">
                            <%= index + 1 %>
                        </th>
                        <td>
                            <%= book.BookName %>
                        </td>
                        <td>
                            <%= book.BookAuth %>
                        </td>
                        <td>
                            <%= book.BookPrice %>
                        </td>
                        <td>
                            <%= book.BookLang %>
                        </td>
                        <td><img src="<%= book.BookImg %>" alt="" width="50"></td>

                        <td>
                            <button class="btn btn-danger"><a
                                    href="/bookDelete?BookId=<%= book.id %>">Delete</a></button>
                            <button class="btn btn-primary"><a href="/bookUpdate">Edit</a></button>
                        </td>
                    </tr>

                    <% }) %>
            </tbody>
        </table>
    </div>
    <center><button class="btn btn-secondary"><a href="/AddBookPage">Go To Add Book</a></button></center>
</body>

</html>