<body>
    <!-- Header -->
    <div class="header">
        <div class="header-left">
            <i class="ri-menu-line menu-icon" onclick="toggleSidebar()"></i>
            <div class="logo">
                <i class="ri-youtube-fill"></i>
                <span>YouTube</span>
            </div>
        </div>
        <div class="header-center">
            <div class="search-box">
                <input type="text" class="search-input" placeholder="Search">
                <button class="search-btn">
                    <i class="ri-search-line"></i>
                </button>
            </div>
            <button class="voice-btn">
                <i class="ri-mic-line"></i>
            </button>
        </div>
        <div class="header-right">
            <a href="/addVideoForm"><i class="ri-video-add-line header-icon"></i></a>
            <i class="ri-notification-3-line header-icon"></i>
            <div class="profile-icon">
                <i class="ri-user-fill"></i>
            </div>
        </div>
    </div>

    <!-- Sidebar -->
    <div class="sidebar" id="sidebar">
        <!-- Home Section -->
        <div class="sidebar-section">
            <div class="sidebar-item active">
                <i class="ri-home-5-fill"></i>
                <span>Home</span>
            </div>
            <div class="sidebar-item">
                <i class="ri-compass-3-line"></i>
                <span>Explore</span>
            </div>
            <div class="sidebar-item">
                <i class="ri-play-circle-line"></i>
                <span>Shorts</span>
            </div>
            <div class="sidebar-item">
                <i class="ri-tv-line"></i>
                <span>Subscriptions</span>
            </div>
        </div>

        <!-- You Section -->
        <div class="sidebar-section">
            <div class="sidebar-item">
                <i class="ri-play-list-2-line"></i>
                <span>Library</span>
            </div>
            <div class="sidebar-item">
                <i class="ri-history-line"></i>
                <span>History</span>
            </div>
            <div class="sidebar-item">
                <i class="ri-video-line"></i>
                <span>Your videos</span>
            </div>
            <div class="sidebar-item">
                <i class="ri-time-line"></i>
                <span>Watch Later</span>
            </div>
            <div class="sidebar-item">
                <i class="ri-thumb-up-line"></i>
                <span>Liked videos</span>
            </div>
            <div class="show-more">
                <i class="ri-arrow-down-s-line"></i>
                <span>Show more</span>
            </div>
        </div>

        <!-- Subscriptions Section -->
        <div class="sidebar-section">
            <div class="sidebar-title">
                <span>Subscriptions</span>
            </div>
            <div class="channel-item">
                <img src="../uploads/oggy.jpg" alt="Channel" class="channel-avatar">
                <span>OGGY</span>
                <div class="live-badge"></div>
            </div>
            <div class="channel-item">
                <img src="../uploads/techno.jpg" alt="Channel" class="channel-avatar">
                <span>Techno Gamerz</span>
            </div>
            <div class="channel-item">
                <img src="../uploads/Mrbeast.jpg" alt="Channel" class="channel-avatar">
                <span>MrBeast</span>
            </div>
            <div class="channel-item">
                <img src="../uploads/himeesh.jpg" alt="Channel" class="channel-avatar">
                <span>Him-eesh Madaan</span>
            </div>
            <div class="channel-item">
                <img src="../uploads/mrindian.jpg" alt="Channel" class="channel-avatar">
                <span>MR. INDIAN HACKER</span>
            </div>
            <div class="channel-item">
                <img src="../uploads/codewithharry.jpg" alt="Channel" class="channel-avatar">
                <span>CodeWithHarry</span>
            </div>
            <div class="channel-item">
                <img src="../uploads/techbururner.jpg" alt="Channel" class="channel-avatar">
                <span>Tech Burner</span>
            </div>
            <div class="show-more">
                <i class="ri-arrow-down-s-line"></i>
                <span>Show more</span>
            </div>
        </div>

        <!-- setting -->
        <div class="sidebar-section">
            <div class="sidebar-item">
                <i class="ri-settings-4-line"></i>
                <span>Setting</span>
            </div>
            <div class="sidebar-item">
                <i class="ri-flag-fill"></i>
                <span>Report History</span>
            </div>
            <div class="sidebar-item">
                <i class="ri-question-line"></i>
                <span>Help</span>
            </div>
            <div class="sidebar-item">
                <i class="ri-feedback-line"></i>
                <span>Send Feedback</span>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="main-content" id="mainContent">
        <!-- Chips -->
        <div class="chips-container">
            <div class="chip active">All</div>
            <div class="chip">Music</div>
            <div class="chip">Gaming</div>
            <div class="chip">Live</div>
            <div class="chip">News</div>
            <div class="chip">Podcasts</div>
            <div class="chip">Computer Science</div>
            <div class="chip">Programming</div>
            <div class="chip">Web Development</div>
            <div class="chip">JavaScript</div>
            <div class="chip">React</div>
            <div class="chip">Node.js</div>
            <div class="chip">Tutorial</div>
            <div class="chip">Entertainment</div>
            <div class="chip">Sports</div>
        </div>

        <!-- Video Grid -->
        <div class="video-container">
            <% videos.map((video, index)=> { %>
                <div class="video-card">
                    <div class="thumbnail-container">
                        <a href="<%= video['VideoLink'] %>"><img src="/<%= video['Thumnail'] %>" alt="Thumbnail"
                                class="thumbnail">
                            <img src="/<%= video['VideoGif'] %>" alt="Preview" class="thumbnail hover-gif"></a>

                        <span class="video-duration">
                            <%= video['Duration'] %>
                        </span>

                        <button class="menu-trigger" onclick="toggleMenu(event, '<%= index %>')">
                            <i class="ri-more-2-fill"></i>
                        </button>

                        <!-- Dropdown Menu -->
                        <div class="dropdown-menu" id="menu-<%= index %>">
                            <div class="dropdown-item">
                                <a href="/editVideo/<%= video['id'] %>">
                                    <i class="ri-edit-line"></i>
                                    <span>Edit</span>
                                </a>
                            </div>
                            <div class="dropdown-item">
                                <a href="/deleteVideo/<%= video['id'] %>">
                                    <i class="ri-delete-bin-line"></i>
                                    <span>Delete</span>
                                </a>
                            </div>
                        </div>
                    </div>

                    <div class="video-info">
                        <img src="/<%= video['Profile'] %>" alt="Channel" class="channel-icon">
                        <div class="video-details">
                            <div class="video-title">
                                <%= video['Title'] %>
                            </div>
                            <div class="channel-name">
                                <%= video['Channel'] %>
                            </div>
                            <div class="video-meta">
                                <%= video['Views'] %> • 2 days ago
                            </div>
                        </div>
                    </div>
                </div>
                <% }) %>
        </div>
    </div>

    <script>
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const mainContent = document.getElementById('mainContent');

            if (window.innerWidth <= 1024) {
                sidebar.classList.toggle('open');
            } else {
                sidebar.classList.toggle('closed');
                mainContent.classList.toggle('expanded');
            }
        }

        function toggleMenu(event, index) {
            event.stopPropagation();
            const menu = document.getElementById(`menu-${index}`);
            const allMenus = document.querySelectorAll('.dropdown-menu');

            // Close all other menus
            allMenus.forEach(m => {
                if (m !== menu) {
                    m.classList.remove('active');
                }
            });

            // Toggle current menu
            menu.classList.toggle('active');
        }

        // Close menu when clicking outside
        document.addEventListener('click', function (event) {
            if (!event.target.closest('.menu-trigger')) {
                const allMenus = document.querySelectorAll('.dropdown-menu');
                allMenus.forEach(m => m.classList.remove('active'));
            }
        });

        // Handle window resize
        window.addEventListener('resize', function () {
            const sidebar = document.getElementById('sidebar');
            const mainContent = document.getElementById('mainContent');

            if (window.innerWidth > 1024) {
                sidebar.classList.remove('open');
            }
        });
    </script>
</body>

</html>