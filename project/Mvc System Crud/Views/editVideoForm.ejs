<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Video - YouTube Studio</title>
    <link rel="stylesheet" href="../public/dist/edit.css">
</head>

<body>

    <div class="modal">
        <div class="header">
            <div class="header-top">
                <h2>Edit Video Details</h2>
                <span><a href="/" style="color: white; text-decoration: none; font-size: 24px;">&times;</a></span>
            </div>
        </div>

        <form action="/update-video" method="POST" enctype="multipart/form-data" style="display: contents;">
            <input type="hidden" name="id" value="<%= SingleVideoFatch._id %>">

            <div class="content-area">

                <div class="form-section">
                    <h3>Details</h3>

                    <div class="input-box">
                        <label>Title (required)</label>
                        <input type="text" name="Title" value="<%= SingleVideoFatch.Title %>" required>
                    </div>

                    <div class="uploads-container">
                        <div class="upload-field">
                            <h4>Video Thumbnail</h4>
                            <label for="thumb-input" class="edit-upload-box">
                                <svg xmlns="http://www.w3.org/2000/svg" height="24" viewBox="0 0 24 24" width="24">
                                    <path
                                        d="M19 5v14H5V5h14m0-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-4.86 8.86l-3 3.87L9 13.14 6 17h12l-3.86-5.14z" />
                                </svg>
                                <span>Update Image</span>
                            </label>
                            <input type="file" id="thumb-input" name="Thumnail" style="display: none;"
                                onchange="previewUpdate(this, 'main-preview-img')">
                        </div>

                        <div class="upload-field">
                            <h4>Channel Logo</h4>
                            <label for="profile-input" class="edit-upload-box">
                                <svg xmlns="http://www.w3.org/2000/svg" height="24" viewBox="0 0 24 24" width="24">
                                    <path
                                        d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z" />
                                </svg>
                                <span>Update Profile</span>
                            </label>
                            <input type="file" id="profile-input" name="Profile" style="display: none;"
                                onchange="previewUpdate(this, 'logo-preview-img')">
                        </div>
                        <div class="upload-field">
                            <h4>Video GIF</h4>
                            <label for="gif-input" class="edit-upload-box">
                                <svg xmlns="http://www.w3.org/2000/svg" height="24" viewBox="0 0 24 24" width="24"
                                    fill="#aaa">
                                    <path
                                        d="M11.5 9H13v6h-1.5V9zM9 9H6c-.6 0-1 .4-1 1v4c0 .6.4 1 1 1h3c.6 0 1-.4 1-1v-2H8.5v1.5h-2v-3H10V10c0-.6-.4-1-1-1zm9 1.5V9h-4.5v6H15v-2h2v-1.5h-2v-1h3z" />
                                </svg>
                                <span>Update GIF</span>
                            </label>
                            <input type="file" id="gif-input" name="VideoGif" style="display: none;"
                                onchange="previewUpdate(this, 'gif-preview-img')">
                        </div>
                    </div>

                    <div class="input-box">
                        <label>Channel Name</label>
                        <input type="text" name="Channel" value="<%= SingleVideoFatch.Channel %>" required>
                    </div>

                    <div class="input-box">
                        <label>Views Count</label>
                        <input type="text" name="Views" value="<%= SingleVideoFatch.Views %>" required>
                    </div>
                </div>

                <div class="preview-section">
                    <div class="video-preview-window">
                        <img id="main-preview-img" src="/<%= SingleVideoFatch.Thumnail %>" alt="Thumbnail">
                    </div>
                    <div class="preview-details">
                        <p class="link-label">Video link</p>
                        <div class="link-with-logo">
                            <div class="mini-profile-preview">
                                <img id="logo-preview-img" src="/<%= SingleVideoFatch.Profile %>" alt="Profile">
                            </div>
                            <p class="link-url">
                                <%= SingleVideoFatch.VideoLink %>
                            </p>
                        </div>

                        <p class="link-label">Status</p>
                        <p style="font-size: 13px; color: #3ea6ff;">✓ Published</p>
                    </div>
                </div>

            </div>

            <div class="footer">
                <a href="/" class="btn-cancel">CANCEL</a>
                <button type="submit" class="btn-save">SAVE CHANGES</button>
            </div>
        </form>
    </div>

    <script>
        // Live Preview Function
        function previewUpdate(input, targetId) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    const previewImg = document.getElementById(targetId);
                    previewImg.src = e.target.result;

                    // Agar GIF update kar rahe ho toh preview window ko show karne ke liye logic
                    if (targetId === 'gif-preview-img') {
                        previewImg.style.opacity = '1'; // Edit mode mein live dikhane ke liye
                    }
                }
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>

</body>

</html>