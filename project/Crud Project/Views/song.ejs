<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Spotify Crud Project</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="../dist/style.css">
</head>

<body>
    <div class="header">
        <div class="header-left">
            <button class="play-btn">
                <i class="fas fa-play"></i>
            </button>
            <div class="action-icons">
                <button class="action-icon"><i class="fas fa-shuffle"></i></button>
                <button class="action-icon"><i class="fas fa-download"></i></button>
                <button class="action-icon"><i class="fas fa-user-plus"></i></button>
                <button class="action-icon"><i class="fas fa-ellipsis"></i></button>
            </div>
        </div>
        <div>
            <a href="/songAddPage"><button class="add-song-btn">Add Song</button></a>
        </div>
    </div>

    <div class="song-list">
        <div class="song-header">
            <div>#</div>
            <div>Artist</div>
            <div>Album</div>
            <div>Date added</div>
            <div><i class="far fa-clock"></i></div>
        </div>

        <% allSong.map((Song, index)=> { %>
            <div class="song-row">
                <div class="song-number">
                    <%= index + 1 %>
                </div>

                <div class="song-info">
                    <img src="<%= Song.songImg %>" alt="Album Cover" class="song-thumbnail">
                    <div class="song-details">
                        <div class="song-title">
                            <%= Song.songTitle %>
                        </div>
                        <div class="song-artist">
                            <%= Song.songAuth %>
                        </div>
                    </div>
                </div>

                <div class="song-album">
                    <%= Song.songAlbum %>
                </div>
                <div class="song-date">
                    <%= Song.songAddDate %>
                </div>
                <div class="song-duration">
                    <%= Song.songDuration %>
                </div>

                <div class="dropdown">
                    <button class="dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <a class="dropdown-item" href="/SongEdit/<%= Song.id %>">
                                <i class="fas fa-edit"></i> Edit
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" href="/SongDelete/<%= Song.id %>">
                                <i class="fas fa-trash"></i> Delete
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
            <% }) %>
    </div>
</body>

</html>