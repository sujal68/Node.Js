<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>YouTube Studio Upload UI</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: "Roboto", Arial, sans-serif;
        }

        body {
            background-color: #0f0f0f;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            color: #f1f1f1;
        }

        /* Modal Container */
        .modal {
            background-color: #282828;
            width: 90%;
            max-width: 960px;
            height: 85vh;
            border-radius: 12px;
            display: flex;
            flex-direction: column;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
            overflow: hidden;
            border: 1px solid #3e3e3e;
        }

        /* Header */
        .header {
            padding: 20px 24px;
            border-bottom: 1px solid #3e3e3e;
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .header-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .header-top h2 {
            font-size: 20px;
            font-weight: 500;
        }

        /* Main Content Scrollable Area */
        .content-area {
            flex: 1;
            overflow-y: auto;
            display: grid;
            grid-template-columns: 1.5fr 1fr;
            gap: 24px;
            padding: 24px;
        }

        /* Form Styling (Left Side) */
        .form-section h3 {
            margin-bottom: 20px;
            font-size: 24px;
        }

        .input-box {
            position: relative;
            margin-bottom: 25px;
            border: 1px solid #606060;
            border-radius: 4px;
            padding: 8px 12px;
        }

        .input-box:focus-within {
            border-color: #3ea6ff;
        }

        .input-box label {
            display: block;
            font-size: 12px;
            color: #aaa;
            margin-bottom: 4px;
        }

        .input-box input {
            width: 100%;
            background: transparent;
            border: none;
            color: white;
            font-size: 15px;
            outline: none;
        }

        /* ----- Styled Thumbnail Section ----- */
        .thumbnail-container {
            margin-bottom: 25px;
        }

        .thumbnail-container h4 {
            font-size: 15px;
            font-weight: 500;
            margin-bottom: 4px;
        }

        .thumbnail-container p {
            font-size: 12px;
            color: #aaa;
            margin-bottom: 12px;
        }

        .upload-box {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            width: 126px;
            height: 84px;
            border: 1px dashed #606060;
            border-radius: 2px;
            cursor: pointer;
            color: #aaa;
            transition: background 0.2s;
        }

        .upload-box:hover {
            background-color: #333;
            border-color: #909090;
        }

        .upload-box svg {
            fill: #aaa;
            margin-bottom: 6px;
        }

        .upload-box span {
            font-size: 11px;
            font-weight: 400;
        }

        /* Right Side Preview */
        .preview-section {
            background-color: #1f1f1f;
            border-radius: 8px;
            height: fit-content;
            overflow: hidden;
            position: sticky;
            top: 0;
        }

        .video-placeholder {
            width: 100%;
            aspect-ratio: 16/9;
            background-color: #000;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #606060;
        }

        .preview-details {
            padding: 16px;
        }

        .link-label {
            font-size: 12px;
            color: #aaa;
        }

        .link-url {
            color: #3ea6ff;
            font-size: 14px;
            margin-bottom: 12px;
            cursor: pointer;
        }

        /* Footer */
        .footer {
            padding: 16px 24px;
            border-top: 1px solid #3e3e3e;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background-color: #282828;
        }

        .status-icons {
            display: flex;
            gap: 15px;
            color: #aaa;
            font-size: 14px;
        }

        .btn-next {
            background-color: #3ea6ff;
            color: #000;
            border: none;
            padding: 10px 24px;
            border-radius: 2px;
            font-weight: 500;
            cursor: pointer;
            text-transform: uppercase;
        }

        /* Scrollbar customization */
        .content-area::-webkit-scrollbar {
            width: 8px;
        }

        .content-area::-webkit-scrollbar-thumb {
            background: #606060;
            border-radius: 10px;
        }

        /* Autocomplete Fix */
        .input-box input:-webkit-autofill {
            -webkit-box-shadow: 0 0 0 30px #282828 inset !important;
            -webkit-text-fill-color: white !important;
        }
    </style>
</head>

<body>

    <div class="modal">
        <div class="header">
            <div class="header-top">
                <h2>Video Management</h2>
                <span style="cursor:pointer; font-size: 24px;">&times;</span>
            </div>
        </div>

        <form action="/add-video" method="POST" enctype="multipart/form-data" style="display: contents;">
            <div class="content-area">

                <div class="form-section">
                    <h3>Details</h3>

                    <div class="input-box">
                        <label>Title (required)</label>
                        <input type="text" name="Title" placeholder="Add a title that describes your video" required>
                    </div>

                    <div class="thumbnail-container">
                        <h4>Thumbnail</h4>
                        <p>Set a thumbnail that stands out. <a href="#"
                                style="color: #3ea6ff; text-decoration: none;">Learn more</a></p>

                        <label for="thumbnail-upload" class="upload-box">
                            <svg xmlns="http://www.w3.org/2000/svg" height="24" viewBox="0 0 24 24" width="24">
                                <path
                                    d="M18,20H4V6h9V4H4C2.9,4,2,4.9,2,6v14c0,1.1,0.9,2,2,2h14c1.1,0,2-0.9,2-2v-9h-2V20z" />
                                <path d="M14.24,12.01l-2.32,3.09l-2.2-2.33L11.07,14H6.66L10.7,8.61L14.24,12.01z" />
                                <path d="M20,4h-3V1h-2v3h-3v2h3v3h2V6h3V4z" />
                            </svg>
                            <span>Upload file</span>
                        </label>
                        <input type="file" id="thumbnail-upload" name="Thumnail" required style="display: none;">
                    </div>

                    <div class="input-box">
                        <label>Channel Name</label>
                        <input type="text" name="Channel" placeholder="e.g. Sujal Kidecha" required>
                    </div>

                    <div class="input-box">
                        <label>Channel Profile (Upload image)</label>
                        <input type="file" name="Profile" required>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
                        <div class="input-box">
                            <label>Duration</label>
                            <input type="text" name="Duration" placeholder="e.g. 10:45" required>
                        </div>
                        <div class="input-box">
                            <label>Static Views</label>
                            <input type="text" name="Views" placeholder="e.g. 1.2M views" required>
                        </div>
                    </div>
                </div>

                <div class="preview-section">
                    <div class="video-placeholder">
                        <span>Video Preview will appear here</span>
                    </div>
                    <div class="preview-details">
                        <p class="link-label">Video link</p>
                        <p class="link-url">https://youtu.be/sujal_dev_vibe</p>

                        <p class="link-label">Filename</p>
                        <p style="font-size: 13px;">video_project_final.mp4</p>
                    </div>
                </div>

            </div>

            <div class="footer">
                <div class="status-icons">
                    <span>HD</span> <span>4K</span> <span>CC</span>
                    <span style="margin-left: 10px; color: #3ea6ff;">✓ Checks complete. No issues found.</span>
                </div>
                <button type="submit" class="btn-next">Submit</button>
            </div>
        </form>
    </div>

</body>

</html>