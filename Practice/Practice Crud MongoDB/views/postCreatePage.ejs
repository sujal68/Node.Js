<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Post To Anyone</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="../dist/style.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</head>

<body>
    <div class="linkedin-container">
        <div class="form-header">
            <h1>Create a post</h1>
            <button type="button" class="close-btn">&times;</button>
        </div>

        <form method="post" action="/addPost">
            <div class="form-body">
                <div class="mb-3">
                    <label class="form-label">User Name</label>
                    <input type="text" name="UserName" class="form-control" placeholder="Enter your name" required>
                </div>

                <div class="mb-3">
                    <label class="form-label">User Bio</label>
                    <input type="text" name="UserBio" class="form-control"
                        placeholder="e.g., Software Engineer at Company" required>
                </div>

                <div class="mb-3">
                    <label class="form-label">Profile Picture URL</label>
                    <input type="text" name="UserImg"
                        value="https://media.licdn.com/dms/image/v2/D5603AQFCvam2OgYTLg/profile-displayphoto-scale_100_100/B56ZpjTuT.HkAc-/0/1762602706781?e=1767830400&v=beta&t=B3Vpn1cQHcIddon5l9AfzCwYwnSlx1odlQfxPPT3MbA"
                        class="form-control" placeholder="https://example.com/profile.jpg" required disabled>
                </div>

                <div class="mb-3">
                    <label class="form-label">What do you want to talk about?</label>
                    <textarea name="PostDiscription" class="form-control"
                        placeholder="Share your thoughts..."></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label">Post Image URL</label>
                    <input type="text" name="PostImage" class="form-control" placeholder="https://example.com/image.jpg"
                        required>
                </div>
            </div>

            <div class="form-footer">
                <button class="btn btn-success"><a href="/">View Posts</a></button>
                <button type="submit" class="btn btn-primary">Post</button>
            </div>
        </form>
    </div>
</body>

</html>