<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LinkedIn Feed</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css">
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.0.0/fonts/remixicon.css" rel="stylesheet">
    <link rel="stylesheet" href="../dist/style.css">
    <style>
        body {
            padding: 0px;
        }

        .like-btn.active {
            color: #0a66c2;
            font-weight: 600;
        }

        .like-icon {
            color: #0a66c2;
        }

        .linkedin-right-footer {
            position: fixed;
            right: 220px;
            top: 92px;
            width: 260px;
            font-size: 12px;
            color: #b0b3b8;
        }

        .footer-links div {
            display: flex;
            flex-wrap: wrap;
            gap: 6px 12px;
            margin-bottom: 8px;
        }

        .footer-links a {
            color: #b0b3b8;
            text-decoration: none;
        }

        .footer-links a:hover {
            text-decoration: underline;
        }

        .footer-copy {
            margin-top: 10px;
            color: #8b8f94;
        }
    </style>
</head>

<body>
    <!-- Navbar -->
    <!-- Navbar -->
    <div class="navbar-linkedin">
        <div class="navbar-content">

            <!-- LEFT -->
            <div class="nav-left">
                <div class="linkedin-logo">in</div>

                <div class="search-box">
                    <i class="ri-search-line"></i>
                    <input type="text" placeholder="Search">
                </div>
            </div>

            <!-- CENTER -->
            <div class="nav-center">
                <div class="nav-item active">
                    <i class="ri-home-5-fill"></i>
                    <span>Home</span>
                </div>

                <div class="nav-item">
                    <i class="ri-group-line"></i>
                    <span>My Network</span>
                </div>

                <div class="nav-item">
                    <i class="ri-briefcase-line"></i>
                    <span>Jobs</span>
                </div>

                <div class="nav-item">
                    <i class="ri-chat-3-line"></i>
                    <span>Messaging</span>
                </div>

                <div class="nav-item">
                    <i class="ri-notification-3-line"></i>
                    <span>Notifications</span>
                </div>
            </div>

            <!-- RIGHT -->
            <div class="nav-right">
                <div class="nav-profile">
                    <img src="https://media.licdn.com/dms/image/v2/D4D03AQEXJkoUEJchAA/profile-displayphoto-scale_100_100/B4DZwd0PJhIYAk-/0/1770026765106?e=1773273600&v=beta&t=Cg9Z0IfNhXQ30UhFyLzzBftfo0NwtpM7rpSYVx8C97Q"
                        alt="">
                    <span>Me</span>
                    <i class="ri-arrow-down-s-line"></i>
                </div>

                <div class="nav-divider"></div>

                <div class="nav-business">
                    <i class="ri-apps-2-line"></i>
                    <span>For Business</span>
                </div>

                <a href="/postAddPage" class="add-post-btn">
                    <i class="ri-add-line"></i> Create
                </a>
            </div>

        </div>
    </div>


    <!-- Feed Container -->
    <div class="feed-container">
        <% allPost.map((Post, index)=> { %>
            <div class="post-card">
                <!-- Post Header -->
                <div class="post-header">
                    <div class="post-user-info">
                        <img src="<%= Post.UserImg %>" alt="User Avatar" class="user-avatar">
                        <div class="user-details">
                            <h3 class="user-name">
                                <%= Post.UserName %>
                            </h3>
                            <p class="user-bio">
                                <%= Post.UserBio %>
                            </p>
                            <p class="post-time">2w • 🌐</p>
                        </div>
                    </div>
                    <div class="post-options">
                        <button class="three-dots-btn" onclick="toggleDropdown('<%= index %>')">
                            <i class="ri-more-fill"></i>
                        </button>
                        <div class="dropdown-menu-custom" id="dropdown-<%= index %>">
                            <a href="/postEdit/<%= Post.id %>" class="dropdown-item-custom">
                                <i class="ri-edit-line"></i> Edit Post
                            </a>
                            <a href="/postDelete/<%= Post.id %>" class="dropdown-item-custom delete-item">
                                <i class="ri-delete-bin-line"></i> Delete Post
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Post Content -->
                <div class="post-content">
                    <p class="post-description">
                        <%= Post.PostDiscription %>
                    </p>
                    <button class="read-more-btn" onclick="toggleReadMore('<%= index %>')">
                        Read more
                    </button>
                </div>

                <!-- Post Image -->
                <img src="<%= Post.PostImage %>" alt="Post Image" class="post-image">

                <!-- Post Stats -->
                <div class="post-stats">
                    <span>
                        <i class="ri-thumb-up-fill like-icon"></i>
                        <span id="like-text-<%= index %>">0 Likes</span>
                    </span>
                    <span>4 comments</span>
                </div>

                <!-- Post Actions -->
                <div class="post-actions">
                    <button class="action-btn like-btn" onclick="toggleLike('<%= index %>')">
                        <i class="ri-thumb-up-line action-icon" id="like-icon-<%= index %>"></i>
                        Like
                    </button>

                    <button class="action-btn">
                        <i class="ri-chat-3-line action-icon"></i>
                        Comment
                    </button>
                    <button class="action-btn">
                        <i class="ri-repeat-line action-icon"></i>
                        Repost
                    </button>
                    <button class="action-btn">
                        <i class="ri-send-plane-line action-icon"></i>
                        Send
                    </button>
                </div>
            </div>
            <% }) %>
    </div>
    <div class="linkedin-right-footer">
        <div class="footer-links">
            <div>
                <a href="#">About</a>
                <a href="#">Accessibility</a>
                <a href="#">Help Center</a>
            </div>

            <div>
                <a href="#">Privacy & Terms</a>
                <a href="#">Ad Choices</a>
                <a href="#">Advertising</a>
            </div>

            <div>
                <a href="#">Business Services</a>
                <a href="#">Get the LinkedIn app</a>
                <a href="#">More</a>
            </div>
        </div>

        <div class="footer-copy">
            LinkedIn Corporation © 2025
        </div>
    </div>


    <script>
        function toggleDropdown(index) {
            const dropdown = document.getElementById(`dropdown-${index}`);
            const allDropdowns = document.querySelectorAll('.dropdown-menu-custom');

            // Close all other dropdowns
            allDropdowns.forEach((d, i) => {
                if (i !== index) {
                    d.classList.remove('show');
                }
            });

            // Toggle current dropdown
            dropdown.classList.toggle('show');
        }

        // Close dropdown when clicking outside
        document.addEventListener('click', function (event) {
            if (!event.target.closest('.post-options')) {
                document.querySelectorAll('.dropdown-menu-custom').forEach(d => {
                    d.classList.remove('show');
                });
            }
        });
        const likes = {};

        function toggleLike(index) {
            if (!likes[index]) {
                likes[index] = { count: 0, liked: false };
            }

            const data = likes[index];
            const icon = document.getElementById(`like-icon-${index}`);
            const text = document.getElementById(`like-text-${index}`);
            const btn = icon.closest('.like-btn');

            if (data.liked) {
                data.count--;
                data.liked = false;
                btn.classList.remove('active');
            } else {
                data.count++;
                data.liked = true;
                btn.classList.add('active');
            }

            text.innerText = `${data.count} Likes`;
        }
    </script>
</body>

</html>