<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LinkedIn Feed</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css">
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.0.0/fonts/remixicon.css" rel="stylesheet">
    <link rel="stylesheet" href="../dist/style.css">
    <style>
        body {
            padding: 0px;
        }
    </style>
</head>

<body>
    <!-- Navbar -->
    <!-- Navbar -->
    <div class="navbar-linkedin">
        <div class="navbar-content">

            <!-- LEFT -->
            <div class="nav-left">
                <div class="linkedin-logo">in</div>

                <div class="search-box">
                    <i class="ri-search-line"></i>
                    <input type="text" placeholder="Search">
                </div>
            </div>

            <!-- CENTER -->
            <div class="nav-center">
                <div class="nav-item active">
                    <i class="ri-home-5-fill"></i>
                    <span>Home</span>
                </div>

                <div class="nav-item">
                    <i class="ri-group-line"></i>
                    <span>My Network</span>
                </div>

                <div class="nav-item">
                    <i class="ri-briefcase-line"></i>
                    <span>Jobs</span>
                </div>

                <div class="nav-item">
                    <i class="ri-chat-3-line"></i>
                    <span>Messaging</span>
                </div>

                <div class="nav-item">
                    <i class="ri-notification-3-line"></i>
                    <span>Notifications</span>
                </div>
            </div>

            <!-- RIGHT -->
            <div class="nav-right">
                <div class="nav-profile">
                    <img src="https://media.licdn.com/dms/image/v2/D5603AQFCvam2OgYTLg/profile-displayphoto-scale_100_100/B56ZpjTuT.HkAc-/0/1762602706781?e=1767830400&v=beta&t=B3Vpn1cQHcIddon5l9AfzCwYwnSlx1odlQfxPPT3MbA"
                        alt="">
                    <span>Me</span>
                    <i class="ri-arrow-down-s-line"></i>
                </div>

                <div class="nav-divider"></div>

                <div class="nav-business">
                    <i class="ri-apps-2-line"></i>
                    <span>For Business</span>
                </div>

                <a href="/postAddPage" class="add-post-btn">
                    <i class="ri-add-line"></i> Create
                </a>
            </div>

        </div>
    </div>


    <!-- Feed Container -->
    <div class="feed-container">
        <% allPost.map((Post, index)=> { %>
            <div class="post-card">
                <!-- Post Header -->
                <div class="post-header">
                    <div class="post-user-info">
                        <img src="<%= Post.UserImg %>" alt="User Avatar" class="user-avatar">
                        <div class="user-details">
                            <h3 class="user-name">
                                <%= Post.UserName %>
                            </h3>
                            <p class="user-bio">
                                <%= Post.UserBio %>
                            </p>
                            <p class="post-time">2w • 🌐</p>
                        </div>
                    </div>
                    <div class="post-options">
                        <button class="three-dots-btn" onclick="toggleDropdown('<%= index %>')">
                            <i class="ri-more-fill"></i>
                        </button>
                        <div class="dropdown-menu-custom" id="dropdown-<%= index %>">
                            <a href="/postEdit/<%= Post.id %>" class="dropdown-item-custom">
                                <i class="ri-edit-line"></i> Edit Post
                            </a>
                            <a href="/postDelete/<%= Post.id %>" class="dropdown-item-custom delete-item">
                                <i class="ri-delete-bin-line"></i> Delete Post
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Post Content -->
                <div class="post-content">
                    <p class="post-description">
                        <%= Post.PostDiscription %>
                    </p>
                    <button class="read-more-btn" onclick="toggleReadMore('<%= index %>')">
                        Read more
                    </button>
                </div>

                <!-- Post Image -->
                <img src="<%= Post.PostImage %>" alt="Post Image" class="post-image">

                <!-- Post Stats -->
                <div class="post-stats">
                    <span><i class="ri-thumb-up-fill" style="color: #0a66c2;"></i> You and 7 others</span>
                    <span>4 comments</span>
                </div>

                <!-- Post Actions -->
                <div class="post-actions">
                    <button class="action-btn">
                        <i class="ri-thumb-up-line action-icon"></i>
                        Like
                    </button>
                    <button class="action-btn">
                        <i class="ri-chat-3-line action-icon"></i>
                        Comment
                    </button>
                    <button class="action-btn">
                        <i class="ri-repeat-line action-icon"></i>
                        Repost
                    </button>
                    <button class="action-btn">
                        <i class="ri-send-plane-line action-icon"></i>
                        Send
                    </button>
                </div>
            </div>
            <% }) %>
    </div>

    <script>
        function toggleDropdown(index) {
            const dropdown = document.getElementById(`dropdown-${index}`);
            const allDropdowns = document.querySelectorAll('.dropdown-menu-custom');

            // Close all other dropdowns
            allDropdowns.forEach((d, i) => {
                if (i !== index) {
                    d.classList.remove('show');
                }
            });

            // Toggle current dropdown
            dropdown.classList.toggle('show');
        }

        // Close dropdown when clicking outside
        document.addEventListener('click', function (event) {
            if (!event.target.closest('.post-options')) {
                document.querySelectorAll('.dropdown-menu-custom').forEach(d => {
                    d.classList.remove('show');
                });
            }
        });

    </script>
</body>

</html>